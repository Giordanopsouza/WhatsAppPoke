# Every var below (except ANALYTICS_*) is validated in app/config.py at import
# time, so **api and worker** need the full agent set — the process crashes on
# boot if one is missing. The analytics service reads only DATABASE_URL plus
# ANALYTICS_*. Copy this file to .env for local dev; in production set them as
# Railway service variables (never commit real values).

# --- Database -------------------------------------------------------------
# Supabase pooler endpoint, port 6543 — must start with postgresql+asyncpg://
DATABASE_URL=

# --- LLM (OpenRouter via Pydantic AI) -------------------------------------
# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OpenRouter model slugs (provider/model). `:nitro` prioritizes the
# highest-throughput compatible provider. Persona (WhatsApp-facing).
OPENROUTER_CHAT_MODEL=google/gemini-3.7-flash:nitro
# Detached Execution agent for owned Gmail/Calendar and local tools.
OPENROUTER_EXEC_MODEL=openai/gpt-oss-120b:nitro
# Detached Execution timeout in seconds (best-effort api task; default 90).
# EXECUTION_TIMEOUT_SECONDS=90

# --- Twilio WhatsApp (sole transport) -------------------------------------
# Account SID + Auth Token from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox: whatsapp:+14155238886  |  or bare +E.164 of your WA sender.
# Must be the Twilio sender, NOT the end-user phone.
# Inbound webhook: https://api.<domain>/webhook/twilio
TWILIO_WHATSAPP_FROM=
# Approved WhatsApp Utility Content Template SID (HX…) for reminder pings
# outside the 24h customer-service window. Template body must include {{1}}
# for the stored reminder body. Create + submit in Twilio Content Template
# Builder (Utility). Inside the window, free-form send_text is used instead.
TWILIO_REMINDER_CONTENT_SID=
# Approved WhatsApp Utility Content Template (HX…) for background automation
# completion / action-needs-response outside the 24h customer-service window.
# Template body must expose {{1}} for the notification summary.
TWILIO_AUTOMATION_CONTENT_SID=
# Optional dedicated template for action confirmation outside 24h window.
# If unset, falls back to TWILIO_AUTOMATION_CONTENT_SID.
TWILIO_ACTION_CONTENT_SID=

# --- Tools ----------------------------------------------------------------
TAVILY_API_KEY=

# --- Observability (task 005) ---------------------------------------------
LOGFIRE_TOKEN=
SENTRY_DSN=

# --- Connect links (ADR 0006 threat model; Composio-backed since 023) -----
# Random secret for signing one-time connect links (itsdangerous). ≥16 chars.
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
CONNECT_SIGNING_KEY=
# Public origin of the api service (no trailing slash). Used to mint connect URLs
# and Composio callback_url. Local: http://localhost:8000
# Prod: https://api.<domain>
APP_BASE_URL=http://localhost:8000

# --- Composio managed auth (task 042+, ADR 0015) ----------------------------
# API key from https://platform.composio.dev — required on api for managed auth
# and the authenticated proxy used by owned tools. No MCP session is created.
# Project setting: log storage = "Don't store data" (LGPD — no tool payloads).
# Enable managed-auth toolkits: gmail, googlecalendar, googledrive,
# googlesheets, notion, trello, clickup (no googlesuper).
# DIY Google OAuth (GOOGLE_CLIENT_*, FERNET_KEY) was removed in task 025.
COMPOSIO_API_KEY=

# --- Analytics dashboard (task 030; analytics service only) ---------------
# api/worker ignore these (extra="ignore"). Required to boot Streamlit.
ANALYTICS_USER=
ANALYTICS_PASSWORD=
# Comma-separated test numbers to hide. +E.164 or digits-only both work.
# ANALYTICS_EXCLUDE_PHONES=+5511999999999,5511888888888
# ANALYTICS_TZ=America/Sao_Paulo

# --- Railway-provided (do not set by hand) --------------------------------
# PORT — set explicitly per service (api=8000, analytics=8501); Railway does
# not inject it. See ADR 0004.

# --- Local dev only, unused in production ---------------------------------
# Supabase dashboard credentials; app/config.py ignores them (extra="ignore").
DATABASE_PASSWORD=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
